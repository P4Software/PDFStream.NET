<Project Sdk="Microsoft.NET.Sdk">
  <!-- Target frameworks and language settings come from Directory.Build.props. -->

  <PropertyGroup>
    <RootNamespace>PDFStream.Tests</RootNamespace>
    <!-- xUnit.net v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code is not a published API, so it does not produce an XML documentation file. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      xUnit.net v3 (Apache-2.0) is chosen over v2 because later tasks need a test to skip itself
      at run time with a visible reason (Assert.Skip), for example when a printer driver is absent.

      "dotnet test" runs these tests through Microsoft Testing Platform, switched on by the
      "test.runner" setting in global.json at the repository root. That setting is required:
      xUnit v3 4.x is built on Microsoft Testing Platform, and from the .NET 10 SDK on the older
      VSTest route stops with "Testing with VSTest target is no longer supported". Consequences:
      point dotnet test at the solution or at this project with its solution / project options;
      the 32-bit host only works with the project option plus the x86 architecture option; and
      filtering uses the xUnit trait and method filters, not the VSTest filter option.

      Microsoft.NET.Test.Sdk (MIT) and xunit.runner.visualstudio (Apache-2.0) stay only for IDE
      test explorers that still use VSTest, as the xUnit documentation recommends.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!--
      PDFsharp generates the test PDFs (text pages, mixed page sizes, user and owner passwords).
      Pinned EXACTLY to 6.2.4 on purpose: 6.2.4 is MIT licensed (licence file at the v6.2.4 tag),
      but PDFsharp 6.5.0 and later, including the 7.0 previews, are AGPL-3.0-only. Do not raise
      this version. It is used only here, in the test project, and never ships with PDFStream.
    -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
  </ItemGroup>

  <!--
    PDFsharp 6.2.4 asks for System.Security.Cryptography.Pkcs 8.0.1, which has published security
    advisories (NU1902/NU1903). Referencing the patched servicing release of the same package
    (MIT, .NET Foundation) directly lifts the transitive version.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PDFStream\PDFStream.csproj" />
  </ItemGroup>

  <!--
    The test-print sample targets net10.0-windows only, so a net8.0-windows test build cannot
    reference it. Its tests (Sample folder) are therefore compiled and run for net10.0-windows only;
    they test plain logic that does not depend on the target framework.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\..\samples\PDFStream.TestPrint\PDFStream.TestPrint.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Sample\**" />
  </ItemGroup>
</Project>
