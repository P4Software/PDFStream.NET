<Project Sdk="Microsoft.NET.Sdk">
  <!-- Target frameworks, nullable, XML docs, licence and version come from Directory.Build.props. -->

  <PropertyGroup>
    <RootNamespace>PDFStream.NET</RootNamespace>
    <AssemblyName>PDFStream.NET</AssemblyName>
    <!--
      The Description is the summary nuget.org shows in search results and at the top of the package page, and
      the text its search ranks: it leads with what the package does for the reader and carries the words people
      search for (silent PDF printing, Windows, services, servers, no Adobe Reader, no licence keys).
    -->
    <Description>Silent PDF printing for .NET on Windows: print a PDF file, stream or byte array to any local or network printer in one call, with no print dialog and no Adobe Reader. Made for Windows services, background jobs and servers that print unattended. Free and open source (MIT), powered by the bundled PDFium engine, with no licence keys, watermarks or telemetry.</Description>
  </PropertyGroup>

  <!--
    NuGet package metadata. Authors, copyright, the MIT licence expression and the version come from
    Directory.Build.props. There is deliberately no SourceLink package and no symbol package: the SDK's
    own repository information (the commit the package was built from) is all the package carries.
  -->
  <PropertyGroup Label="NuGet package">
    <!--
      The package id, the title, the assembly (PDFStream.NET.dll, from AssemblyName above) and the C# namespace
      (PDFStream.NET) all carry the same name, so what a developer installs, references and types is one name:
      "using PDFStream.NET;". Keep them identical: renaming the assembly or namespace after release breaks every
      caller.
    -->
    <PackageId>PDFStream.NET</PackageId>
    <Title>PDFStream.NET</Title>
    <!-- MSBuild takes the tags separated by semicolons; the nuspec gets them separated by spaces, as nuget.org wants. -->
    <PackageTags>pdf;print;printing;printer;silent;windows;pdfium;batch;automation;server;service;pdf-printing</PackageTags>
    <!-- The picture nuget.org and IDE package managers show; drawn by tools/make-icon.ps1, packed below. -->
    <PackageIcon>icon.png</PackageIcon>
    <!-- README.nuget.md, packed under this name (see below). The repository README.md stays the GitHub page. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Shown on nuget.org as "Release Notes" for this version; the changelog keeps the full history. -->
    <PackageReleaseNotes>1.0.0-rc.2 gives the package a proper nuget.org page: an icon, a readme written for nuget.org, a clearer description, search tags and these release notes. The library code is unchanged from 1.0.0-rc.1. Full changelog: https://github.com/P4Software/PDFStream.NET/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/P4Software/PDFStream.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/P4Software/PDFStream.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup Label="Files shipped in the package root">
    <!--
      README.nuget.md is the package page on nuget.org, written for it: no HTML, only absolute https links,
      and images only from hosts nuget.org allows (shields.io badges). It is packed under the name README.md,
      which PackageReadmeFile above points to; the repository's own README.md is the GitHub page and is not
      packed. icon.png is the package icon. Both files sit in this folder, so the SDK's default None glob lists
      them in each per-framework build, but not in the outer build that "dotnet pack" runs for a multi-targeted
      project; an Update alone would therefore pack nothing. They are removed from the glob and included once,
      explicitly, so both builds see exactly one item each.

      The licence and the third-party notices travel with every copy of the package: the Apache-2.0 parts of
      PDFium require that recipients get the licence texts, which are in THIRD-PARTY-NOTICES.md.
    -->
    <None Remove="README.nuget.md;icon.png" />
    <None Include="README.nuget.md" Pack="true" PackagePath="README.md" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine types are internal; the tests exercise them directly. -->
    <InternalsVisibleTo Include="PDFStream.NET.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Prebuilt PDFium (BSD-3-Clause / Apache-2.0, packaging MIT) for win-x64, win-x86 and
      win-arm64. PDFStream.NET calls it through its own P/Invoke declarations in Engine/PdfiumNative.cs.
      See THIRD-PARTY-NOTICES.md for why this package was chosen over the PDFiumCore bindings.

      pdfium.dll is not copied into the PDFStream.NET package: this reference becomes a normal NuGet
      dependency, and its runtimes/win-<arch>/native folders give a consuming app the pdfium.dll for its
      processor with no extra step. Checked with separate consumer apps, under the package's earlier names and
      then under PDFStream.NET. CHANGELOG.md lists exactly what was run and under which name; CONTRIBUTING.md
      says how to repeat it.
    -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="160.0.8165" />
  </ItemGroup>

  <!--
    System.Drawing (Bitmap, and later PrintDocument) comes from the System.Drawing.Common package
    rather than from <UseWindowsForms>. A Windows Forms framework reference would force every
    consumer to install the Windows Desktop runtime, which Windows services and IIS hosts (the
    main use case) usually do not have. Each target framework gets the matching servicing line.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.34" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
  </ItemGroup>
</Project>
