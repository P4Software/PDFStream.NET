<Project>
  <!--
    Settings shared by every project in the repository (library, tests and, later, the sample).
    A project overrides any of them in its own .csproj when it needs to (for example the
    test project turns off the XML documentation file).
  -->

  <PropertyGroup Label="Targets and language">
    <!--
      net10.0-windows is what the first real user runs; net8.0-windows is the long-term-support
      release many developers are still on. The "-windows" suffix is deliberate: printing goes
      through the Windows print system and the PDFium binaries shipped are Windows ones.
    -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <!--
      Pinned rather than "latest", so the language does not change with whichever SDK happens to be
      installed. C# 12 is the newest version the .NET 8 SDK supports, and the .NET 10 SDK builds it too.
    -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Documentation">
    <!--
      Every public type and member must carry XML documentation. Turning the "missing XML
      comment" warning (CS1591) into an error makes the build enforce it instead of a reviewer.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Identity and licence">
    <Authors>P4 Software</Authors>
    <Company>P4 Software</Company>
    <Product>PDFStream.NET</Product>
    <Copyright>Copyright (c) 2026 P4 Software</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!--
      The version of the package and of the assembly. The first version published on nuget.org was the release
      candidate 1.0.0-rc.1 (published on 2026-11-21, the owner's decision). 1.0.0-rc.2 carries the new package
      page (icon, package readme, description, tags, release notes) with no library code change, because a
      version on nuget.org can never be edited or replaced. The stable 1.0.0 follows once the remaining manual
      release checklist rows are verified. A NuGet version is permanent, so this must be exact. Setting it here,
      in the file every build reads, makes a local `dotnet pack` and the CI pack give the same
      PDFStream.NET.1.0.0-rc.2.nupkg with no command-line property. The SDK derives from it:
        PackageVersion / nuspec version  1.0.0-rc.2
        AssemblyVersion and FileVersion  1.0.0.0 (the prerelease suffix is not part of them)
        InformationalVersion             1.0.0-rc.2, plus "+<commit hash>" when the build is inside a git
                                         repository (the SDK adds that on its own; NuGet ignores the
                                         build-metadata part, so the package version stays 1.0.0-rc.2).
      To release another version, change VersionSuffix (delete the line for the stable 1.0.0) and the version
      the package check expects, in .github/scripts/check-package.ps1.
    -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>rc.2</VersionSuffix>
  </PropertyGroup>
</Project>
